{
  "name": "micosm-game",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --hostname 0.0.0.0",
    "dev:lan": "vinext dev --hostname 0.0.0.0",
    "ai": "node scripts/katago-service.mjs",
    "ai:gomoku": "node scripts/rapfi-service.mjs",
    "ai:gomoku:benchmark": "node scripts/rapfi-benchmark.mjs",
    "ai:supervised": "node scripts/ai-supervisor.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/match-clock.test.mjs tests/match-rules.test.mjs tests/ai-engine.test.mjs tests/admin-access.test.mjs tests/rank-season.test.mjs tests/beta-program.test.mjs tests/rapfi-benchmark.test.mjs tests/game-record.test.mjs tests/community.test.mjs tests/platform-portability.test.mjs",
    "test:integration": "node --test tests/match-api.integration.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "verify:linux": "node --test tests/platform-portability.test.mjs",
    "ops:backup": "node scripts/backup-d1.mjs",
    "ops:backup:r2": "node scripts/backup-r2.mjs",
    "ops:restore": "node scripts/restore-d1.mjs",
    "ops:restore:r2": "node scripts/restore-r2.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.28.0",
    "next": "^16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "renjukit": "^0.8.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
