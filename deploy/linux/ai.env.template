# Install as /etc/micosm/ai.env, set mode 0600, and replace both tokens.
# Native paths may be absolute or relative to the project root.

KATAGO_EXE=.tools/katago/engine/katago
KATAGO_MODEL=.tools/katago/kata1-b28c512.bin.gz
KATAGO_CONFIG=.tools/katago/engine/default_gtp.cfg
KATAGO_MODEL_LABEL=b28c512
KATAGO_SERVICE_HOST=127.0.0.1
KATAGO_SERVICE_PORT=3210
KATAGO_SERVICE_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
KATAGO_MAX_QUEUE=6

RAPFI_EXE=.tools/rapfi/engine/pbrain-rapfi-linux-clang-avx2
RAPFI_SERVICE_HOST=127.0.0.1
RAPFI_SERVICE_PORT=3211
RAPFI_SERVICE_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_TOKEN
RAPFI_MAX_QUEUE=8
RAPFI_WORKERS=2
RAPFI_THREADS=4
RAPFI_MEMORY_MB=256
