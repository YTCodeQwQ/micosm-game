[Unit]
Description=Micosm Game KataGo service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=micosm
Group=micosm
WorkingDirectory=/opt/micosm/current
EnvironmentFile=/etc/micosm/ai.env
ExecStart=/usr/bin/node scripts/katago-service.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/micosm/current/.tools/katago
UMask=0027

[Install]
WantedBy=multi-user.target
