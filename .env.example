# Copy only the variables needed by the process being started. Never commit
# real tokens. Relative native-engine paths are resolved from the project root.

# Web Worker -> native AI services
AI_SERVICE_ORIGIN=http://127.0.0.1:3210
AI_SERVICE_TOKEN=
AI_KATAGO_VISITS=1600
AI_KATAGO_SECONDS=3
RAPFI_SERVICE_ORIGIN=http://127.0.0.1:3211
RAPFI_SERVICE_TOKEN=
AI_RAPFI_SECONDS=2.5
HEALTH_CHECK_AI=false
MICO_ADMIN_PUBLIC_IDS=

# KataGo node
KATAGO_EXE=
KATAGO_MODEL=.tools/katago/kata1-b28c512.bin.gz
KATAGO_CONFIG=.tools/katago/engine/default_gtp.cfg
KATAGO_MODEL_LABEL=b28c512
KATAGO_SERVICE_HOST=127.0.0.1
KATAGO_SERVICE_PORT=3210
KATAGO_SERVICE_TOKEN=
KATAGO_MAX_QUEUE=6

# Rapfi node
RAPFI_EXE=
RAPFI_SERVICE_HOST=127.0.0.1
RAPFI_SERVICE_PORT=3211
RAPFI_SERVICE_TOKEN=
RAPFI_MAX_QUEUE=8
RAPFI_WORKERS=2
RAPFI_THREADS=4
RAPFI_MEMORY_MB=256

# Operations
MICO_D1_DATABASE=
